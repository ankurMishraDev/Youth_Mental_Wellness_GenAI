{
  "expo": {
    "name": "Youth Mental Wellness",
    "slug": "youth-mental-wellness-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
